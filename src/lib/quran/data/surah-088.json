{"surah":88,"nameEn":"Al-Ghāshiyah","nameAr":"الغَاشِية ","ayahs":[{"id":5968,"juz":30,"page":592,"lineStart":7,"lineEnd":7,"ayah":1,"text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ﰀ","textImlaei":"هل أتاك حديث الغاشية","tafseer":"[1] هل أتاك -أيها الرسول- خبر القيامة التي تغشى الناس بأهوالها؟"},{"id":5969,"juz":30,"page":592,"lineStart":7,"lineEnd":7,"ayah":2,"text":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ﰁ","textImlaei":"وجوه يومئذ خاشعة","tafseer":"[2] وجوه الكفار يومئذ ذليلة بالعذاب"},{"id":5970,"juz":30,"page":592,"lineStart":7,"lineEnd":8,"ayah":3,"text":"عَامِلَةٞ نَّاصِبَةٞ ﰂ","textImlaei":"عاملة ناصبة","tafseer":"[3]  مجهدة بالعمل متعبة"},{"id":5971,"juz":30,"page":592,"lineStart":8,"lineEnd":8,"ayah":4,"text":"تَصۡلَىٰ نَارًا حَامِيَةٗ ﰃ","textImlaei":"تصلى نارا حامية","tafseer":"[4]  تصيبها نار شديدة التوهج"},{"id":5972,"juz":30,"page":592,"lineStart":8,"lineEnd":8,"ayah":5,"text":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ﰄ","textImlaei":"تسقى من عين آنية","tafseer":"[5] تُسقى مِن عين بلغت منتهى الحرارة"},{"id":5973,"juz":30,"page":592,"lineStart":8,"lineEnd":9,"ayah":6,"text":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ﰅ","textImlaei":"ليس لهم طعام إلا من ضريع","tafseer":"[6] ليس لأصحاب النار طعام إلا مِن نبت ذي شوك لاصق بالأرض، وهو مِن شر الطعام وأخبثه"},{"id":5974,"juz":30,"page":592,"lineStart":9,"lineEnd":9,"ayah":7,"text":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ﰆ","textImlaei":"لا يسمن ولا يغني من جوع","tafseer":"[7] لا يُسْمن بدن صاحبه من الهُزال، ولا يسدُّ جوعه ورَمَقَه."},{"id":5975,"juz":30,"page":592,"lineStart":9,"lineEnd":10,"ayah":8,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ﰇ","textImlaei":"وجوه يومئذ ناعمة","tafseer":"[8] وجوه المؤمنين يوم القيامة ذات نعمة."},{"id":5976,"juz":30,"page":592,"lineStart":10,"lineEnd":10,"ayah":9,"text":"لِّسَعۡيِهَا رَاضِيَةٞ ﰈ","textImlaei":"لسعيها راضية","tafseer":"[9]  لسعيها في الدنيا بالطاعات راضية في الآخرة"},{"id":5977,"juz":30,"page":592,"lineStart":10,"lineEnd":10,"ayah":10,"text":"فِي جَنَّةٍ عَالِيَةٖ ﰉ","textImlaei":"في جنة عالية","tafseer":"[10] في جنة رفيعة المكان والمكانة"},{"id":5978,"juz":30,"page":592,"lineStart":10,"lineEnd":11,"ayah":11,"text":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ﰊ","textImlaei":"لا تسمع فيها لاغية","tafseer":"[11] لا تسمع فيها كلمة لغو واحدة"},{"id":5979,"juz":30,"page":592,"lineStart":11,"lineEnd":11,"ayah":12,"text":"فِيهَا عَيۡنٞ جَارِيَةٞ ﰋ","textImlaei":"فيها عين جارية","tafseer":"[12]  فيها عين تتدفق مياهها"},{"id":5980,"juz":30,"page":592,"lineStart":11,"lineEnd":11,"ayah":13,"text":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ﰌ","textImlaei":"فيها سرر مرفوعة","tafseer":"[13] فيها سرر عالية"},{"id":5981,"juz":30,"page":592,"lineStart":11,"lineEnd":12,"ayah":14,"text":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ ﰍ","textImlaei":"وأكواب موضوعة","tafseer":"[14]  وأكواب معدة للشاربين"},{"id":5982,"juz":30,"page":592,"lineStart":12,"lineEnd":12,"ayah":15,"text":"وَنَمَارِقُ مَصۡفُوفَةٞ ﰎ","textImlaei":"ونمارق مصفوفة","tafseer":"[15] ووسائد مصفوفة، الواحدة جنب الأخرى"},{"id":5983,"juz":30,"page":592,"lineStart":12,"lineEnd":12,"ayah":16,"text":"وَزَرَابِيُّ مَبۡثُوثَةٌ ﰏ","textImlaei":"وزرابي مبثوثة","tafseer":"[16]  وبُسُط كثيرة مفروشة."},{"id":5984,"juz":30,"page":592,"lineStart":12,"lineEnd":13,"ayah":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ﰐ","textImlaei":"أفلا ينظرون إلى الإبل كيف خلقت","tafseer":"[17] أفلا ينظر الكافرون المكذِّبون إلى الإبل: كيف خُلِقَت هذا الخلق العجيب؟"},{"id":5985,"juz":30,"page":592,"lineStart":13,"lineEnd":13,"ayah":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ﰑ","textImlaei":"وإلى السماء كيف رفعت","tafseer":"[18] وإلى السماء كيف رُفِعَت هذا الرَّفع البديع؟"},{"id":5986,"juz":30,"page":592,"lineStart":13,"lineEnd":14,"ayah":19,"text":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ﰒ","textImlaei":"وإلى الجبال كيف نصبت","tafseer":"[19] وإلى الجبال كيف نُصبت، فحصل بها الثبات للأرض والاستقرار؟"},{"id":5987,"juz":30,"page":592,"lineStart":14,"lineEnd":14,"ayah":20,"text":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ﰓ","textImlaei":"وإلى الأرض كيف سطحت","tafseer":"[20] وإلى الأرض كيف بُسِطت ومُهِّدت؟"},{"id":5988,"juz":30,"page":592,"lineStart":15,"lineEnd":15,"ayah":21,"text":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ﰔ","textImlaei":"فذكر إنما أنت مذكر","tafseer":"[21] فعِظْ -أيها الرسول- المعرضين بما أُرْسِلْتَ به إليهم، ولا تحزن على إعراضهم، إنما أنت واعظ لهم"},{"id":5989,"juz":30,"page":592,"lineStart":15,"lineEnd":15,"ayah":22,"text":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ﰕ","textImlaei":"لست عليهم بمصيطر","tafseer":"[22] ليس عليك إكراههم على الإيمان."},{"id":5990,"juz":30,"page":593,"lineStart":1,"lineEnd":1,"ayah":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ﰖ","textImlaei":"إلا من تولى وكفر","tafseer":"[23] لكن الذي أعرض عن التذكير والموعظة وأصرَّ على كفره"},{"id":5991,"juz":30,"page":593,"lineStart":1,"lineEnd":1,"ayah":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ﰗ","textImlaei":"فيعذبه الله العذاب الأكبر","tafseer":"[24] فيعذبه الله العذاب الشديد في النار."},{"id":5992,"juz":30,"page":593,"lineStart":2,"lineEnd":2,"ayah":25,"text":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ﰘ","textImlaei":"إن إلينا إيابهم","tafseer":"[25] إنَّ إلينا مرجعهم بعد الموت"},{"id":5993,"juz":30,"page":593,"lineStart":2,"lineEnd":2,"ayah":26,"text":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ﰙ","textImlaei":"ثم إن علينا حسابهم","tafseer":"[26] ثم إن علينا جزاءهم على ما عملوا."}]}
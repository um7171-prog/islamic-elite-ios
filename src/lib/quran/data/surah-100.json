{"surah":100,"nameEn":"Al-‘Ādiyāt","nameAr":"العَاديَات ","ayahs":[{"id":6147,"juz":30,"page":599,"lineStart":14,"lineEnd":14,"ayah":1,"text":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا ﰀ","textImlaei":"والعاديات ضبحا","tafseer":"[1] أقسم الله تعالى بالخيل الجاريات في سبيله نحو العدوِّ، حين يظهر صوت أنفاسها من سرعة عَدْوِها. ولا يجوز للمخلوق أن يقسم إلا بالله؛ فإن القسم بغير الله شرك."},{"id":6148,"juz":30,"page":599,"lineStart":14,"lineEnd":14,"ayah":2,"text":"فَٱلۡمُورِيَٰتِ قَدۡحٗا ﰁ","textImlaei":"فالموريات قدحا","tafseer":"[2] فالخيلِ اللاتي تنقدح النار من صلابة حوافرها؛ لشدَّة عَدْوها."},{"id":6149,"juz":30,"page":599,"lineStart":14,"lineEnd":15,"ayah":3,"text":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا ﰂ","textImlaei":"فالمغيرات صبحا","tafseer":"[3] فالخيلِ التي تُغير برُكْبانها على الأعداء عند الصبح."},{"id":6150,"juz":30,"page":599,"lineStart":15,"lineEnd":15,"ayah":4,"text":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا ﰃ","textImlaei":"فأثرن به نقعا","tafseer":"[4] فهيَّجْنَ بهذا العَدْو غباراً."},{"id":6151,"juz":30,"page":599,"lineStart":15,"lineEnd":15,"ayah":5,"text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا ﰄ","textImlaei":"فوسطن به جمعا","tafseer":"[5] فتوسَّطن بركبانهن جموع الأعداء."},{"id":6152,"juz":30,"page":600,"lineStart":1,"lineEnd":1,"ayah":6,"text":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ﰅ","textImlaei":"إن الإنسان لربه لكنود","tafseer":"[6] إن الإنسان لِنعم ربه لَجحود"},{"id":6153,"juz":30,"page":600,"lineStart":1,"lineEnd":1,"ayah":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ﰆ","textImlaei":"وإنه على ذلك لشهيد","tafseer":"[7] وإنه بجحوده ذلك لمقر"},{"id":6154,"juz":30,"page":600,"lineStart":1,"lineEnd":2,"ayah":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ﰇ","textImlaei":"وإنه لحب الخير لشديد","tafseer":"[8] وإنه لحب المال لشديد."},{"id":6155,"juz":30,"page":600,"lineStart":2,"lineEnd":2,"ayah":9,"text":"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ﰈ","textImlaei":"أفلا يعلم إذا بعثر ما في القبور","tafseer":"[9] أفلا يعلم الإنسان ما ينتظره إذا أخرج الله الأموات من القبور للحساب والجزاء؟"},{"id":6156,"juz":30,"page":600,"lineStart":3,"lineEnd":3,"ayah":10,"text":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ ﰉ","textImlaei":"وحصل ما في الصدور","tafseer":"[10] واستُخرج ما استتر في الصدور من خير أو شر."},{"id":6157,"juz":30,"page":600,"lineStart":3,"lineEnd":3,"ayah":11,"text":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ﰊ","textImlaei":"إن ربهم بهم يومئذ لخبير","tafseer":"[11] إن ربهم بهم وبأعمالهم يومئذ لخبير، لا يخفى عليه شيء من ذلك."}]}
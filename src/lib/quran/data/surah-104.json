{"surah":104,"nameEn":"Al-Humazah","nameAr":"الهُمَزة ","ayahs":[{"id":6180,"juz":30,"page":601,"lineStart":7,"lineEnd":7,"ayah":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ﰀ","textImlaei":"ويل لكل همزة لمزة","tafseer":"[1] شر وهلاك لكل مغتاب للناسِ، طعَّان فيهم."},{"id":6181,"juz":30,"page":601,"lineStart":7,"lineEnd":7,"ayah":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ﰁ","textImlaei":"الذي جمع مالا وعدده","tafseer":"[2] الذي كان همُّه جمع المال وتَعْداده."},{"id":6182,"juz":30,"page":601,"lineStart":8,"lineEnd":8,"ayah":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ ﰂ","textImlaei":"يحسب أن ماله أخلده","tafseer":"[3] يظن أنه ضَمِنَ لنفسه بهذا المال الذي جمعه، الخلود في الدنيا والإفلات من الحساب."},{"id":6183,"juz":30,"page":601,"lineStart":8,"lineEnd":8,"ayah":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ﰃ","textImlaei":"كلا لينبذن في الحطمة","tafseer":"[4] ليس الأمر كما ظن، ليُطرحنَّ في النار التي تهشم كل ما يُلْقى فيها."},{"id":6184,"juz":30,"page":601,"lineStart":9,"lineEnd":9,"ayah":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ﰄ","textImlaei":"وما أدراك ما الحطمة","tafseer":"[5] وما أدراك -أيها الرسول- ما حقيقة النار؟"},{"id":6185,"juz":30,"page":601,"lineStart":9,"lineEnd":9,"ayah":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ﰅ","textImlaei":"نار الله الموقدة","tafseer":"[6] إنها نار الله المشتعلةُ الشديدةُ اللَّهب"},{"id":6186,"juz":30,"page":601,"lineStart":9,"lineEnd":10,"ayah":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ﰆ","textImlaei":"التي تطلع على الأفئدة","tafseer":"[7]  التي من شدة حرِّها تنفُذ من الأجسام إلى القلوب."},{"id":6187,"juz":30,"page":601,"lineStart":10,"lineEnd":10,"ayah":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ ﰇ","textImlaei":"إنها عليهم مؤصدة","tafseer":"[8] إنها عليهم مطبَقة"},{"id":6188,"juz":30,"page":601,"lineStart":10,"lineEnd":10,"ayah":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ ﰈ","textImlaei":"في عمد ممددة","tafseer":"[9] في سلاسل وأغلال مطوَّلة؛ لئلا يخرجوا منها."}]}
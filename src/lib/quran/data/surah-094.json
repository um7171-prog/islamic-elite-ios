{"surah":94,"nameEn":"Ash-Sharḥ","nameAr":"الشَّرح ","ayahs":[{"id":6091,"juz":30,"page":596,"lineStart":15,"lineEnd":15,"ayah":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ﰀ","textImlaei":"ألم نشرح لك صدرك","tafseer":"[1] ألم نوسع -أيها النبي- لك صدرك لشرائع الدين، والدعوة إلى الله، والاتصاف بمكارم الأخلاق"},{"id":6092,"juz":30,"page":596,"lineStart":15,"lineEnd":15,"ayah":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ ﰁ","textImlaei":"ووضعنا عنك وزرك","tafseer":"[2]  وحططنا عنك بذلك حِمْلك."},{"id":6093,"juz":30,"page":597,"lineStart":1,"lineEnd":1,"ayah":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ﰂ","textImlaei":"الذي أنقض ظهرك","tafseer":"[3] الذي أثقل ظهرك"},{"id":6094,"juz":30,"page":597,"lineStart":1,"lineEnd":1,"ayah":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ ﰃ","textImlaei":"ورفعنا لك ذكرك","tafseer":"[4]  وجعلناك -بما أنعمنا عليك من المكارم- في منزلة رفيعة عالية؟"},{"id":6095,"juz":30,"page":597,"lineStart":1,"lineEnd":1,"ayah":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ﰄ","textImlaei":"فإن مع العسر يسرا","tafseer":"[5] فلا يَثْنِكَ أذى أعدائك عن نشر الرسالة؛ فإن مع الضيق فرجاً"},{"id":6096,"juz":30,"page":597,"lineStart":2,"lineEnd":2,"ayah":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ﰅ","textImlaei":"إن مع العسر يسرا","tafseer":"[6] إن مع الضيق فرجاً."},{"id":6097,"juz":30,"page":597,"lineStart":2,"lineEnd":2,"ayah":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ ﰆ","textImlaei":"فإذا فرغت فانصب","tafseer":"[7] فإذا فرغت من أمور الدنيا وأشغالها فَجِدَّ في العبادة"},{"id":6098,"juz":30,"page":597,"lineStart":2,"lineEnd":2,"ayah":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب ﰇ","textImlaei":"وإلى ربك فارغب","tafseer":"[8] وإلى ربك وحده فارغب فيما عنده."}]}
{"surah":114,"nameEn":"An-Nās","nameAr":"النَّاس ","ayahs":[{"id":6231,"juz":30,"page":604,"lineStart":12,"lineEnd":12,"ayah":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ ﰀ","textImlaei":"قل أعوذ برب الناس","tafseer":"[1] قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس."},{"id":6232,"juz":30,"page":604,"lineStart":12,"lineEnd":12,"ayah":2,"text":"مَلِكِ ٱلنَّاسِ ﰁ","textImlaei":"ملك الناس","tafseer":"[2] ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم."},{"id":6233,"juz":30,"page":604,"lineStart":12,"lineEnd":13,"ayah":3,"text":"إِلَٰهِ ٱلنَّاسِ ﰂ","textImlaei":"إله الناس","tafseer":"[3] إله الناس الذي لا معبود بحق سواه."},{"id":6234,"juz":30,"page":604,"lineStart":13,"lineEnd":13,"ayah":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ ﰃ","textImlaei":"من شر الوسواس الخناس","tafseer":"[4] من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله."},{"id":6235,"juz":30,"page":604,"lineStart":13,"lineEnd":14,"ayah":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ ﰄ","textImlaei":"الذي يوسوس في صدور الناس","tafseer":"[5] الذي يبثُّ الشر والشكوك في صدور الناس."},{"id":6236,"juz":30,"page":604,"lineStart":15,"lineEnd":15,"ayah":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ ﰅ","textImlaei":"من الجنة والناس","tafseer":"[6] من شياطين الجن والإنس."}]}
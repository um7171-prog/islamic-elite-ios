{"surah":80,"nameEn":"‘Abasa","nameAr":"عَبَسَ ","ayahs":[{"id":5759,"juz":30,"page":585,"lineStart":3,"lineEnd":3,"ayah":1,"text":"عَبَسَ وَتَوَلَّىٰٓ ﰀ","textImlaei":"عبس وتولى","tafseer":"[1] ظهر التغير والعبوس في وجه الرسول صلى الله عليه وسلم"},{"id":5760,"juz":30,"page":585,"lineStart":3,"lineEnd":3,"ayah":2,"text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ ﰁ","textImlaei":"أن جاءه الأعمى","tafseer":"[2] وأعرض لأجل أن الأعمى عبدالله بن أم مكتوم جاءه مسترشداً، وكان الرسول -صلى الله عليه وسلم- منشغلاً بدعوة كبار قريش إلى الإسلام."},{"id":5761,"juz":30,"page":585,"lineStart":3,"lineEnd":3,"ayah":3,"text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ﰂ","textImlaei":"وما يدريك لعله يزكى","tafseer":"[3] وأيُّ شيء يجعلك عالماً بحقيقة أمره؟ لعله بسؤاله تزكو نفسه وتطهر"},{"id":5762,"juz":30,"page":585,"lineStart":3,"lineEnd":4,"ayah":4,"text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ﰃ","textImlaei":"أو يذكر فتنفعه الذكرى","tafseer":"[4]أو يحصل له المزيد من الاعتبار والازدجار."},{"id":5763,"juz":30,"page":585,"lineStart":4,"lineEnd":4,"ayah":5,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ ﰄ","textImlaei":"أما من استغنى","tafseer":"[5] أما مَن استغنى عن هديك"},{"id":5764,"juz":30,"page":585,"lineStart":4,"lineEnd":4,"ayah":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ ﰅ","textImlaei":"فأنت له تصدى","tafseer":"[6] فأنت تتعرض له وتصغي إلى كلامه"},{"id":5765,"juz":30,"page":585,"lineStart":4,"lineEnd":5,"ayah":7,"text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ﰆ","textImlaei":"وما عليك ألا يزكى","tafseer":"[7] وأيُّ شيء عليك ألا يتطهر من كفره؟"},{"id":5766,"juz":30,"page":585,"lineStart":5,"lineEnd":5,"ayah":8,"text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ﰇ","textImlaei":"وأما من جاءك يسعى","tafseer":"[8] وأمَّا من كان حريصاً على لقائك"},{"id":5767,"juz":30,"page":585,"lineStart":5,"lineEnd":5,"ayah":9,"text":"وَهُوَ يَخۡشَىٰ ﰈ","textImlaei":"وهو يخشى","tafseer":"[9] وهو يخشى الله من التقصير في الاسترشاد"},{"id":5768,"juz":30,"page":585,"lineStart":5,"lineEnd":5,"ayah":10,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ ﰉ","textImlaei":"فأنت عنه تلهى","tafseer":"[10] فأنت عنه تتشاغل"},{"id":5769,"juz":30,"page":585,"lineStart":6,"lineEnd":6,"ayah":11,"text":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ ﰊ","textImlaei":"كلا إنها تذكرة","tafseer":"[11] . ليس الأمر كما فعلت -أيها الرسول-، إنَّ هذه السورة بما اشتملت عليه من الهداية موعظة لك ولكل من شاء الاتعاظ"},{"id":5770,"juz":30,"page":585,"lineStart":6,"lineEnd":6,"ayah":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ ﰋ","textImlaei":"فمن شاء ذكره","tafseer":"[12] فمن شاء ذكر الله وَأْتَمَّ بوحيه"},{"id":5771,"juz":30,"page":585,"lineStart":6,"lineEnd":6,"ayah":13,"text":"فِي صُحُفٖ مُّكَرَّمَةٖ ﰌ","textImlaei":"في صحف مكرمة","tafseer":"[13] هذا الوحي، وهو القرآن في صحف معظمة، موقرة"},{"id":5772,"juz":30,"page":585,"lineStart":6,"lineEnd":7,"ayah":14,"text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ﰍ","textImlaei":"مرفوعة مطهرة","tafseer":"[14] عالية القدر مطهرة من الدنس والزيادة والنقص"},{"id":5773,"juz":30,"page":585,"lineStart":7,"lineEnd":7,"ayah":15,"text":"بِأَيۡدِي سَفَرَةٖ ﰎ","textImlaei":"بأيدي سفرة","tafseer":"[15]  بأيدي ملائكة كتبة، سفراء بين الله وخلقه"},{"id":5774,"juz":30,"page":585,"lineStart":7,"lineEnd":7,"ayah":16,"text":"كِرَامِۭ بَرَرَةٖ ﰏ","textImlaei":"كرام بررة","tafseer":"[16] كرام الخلق، أخلاقهم وأفعالهم بارة طاهرة."},{"id":5775,"juz":30,"page":585,"lineStart":7,"lineEnd":7,"ayah":17,"text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ﰐ","textImlaei":"قتل الإنسان ما أكفره","tafseer":"[17] لُعِنَ الإنسان الكافر وعُذِّب، ما أشدَّ كفره بربه!"},{"id":5776,"juz":30,"page":585,"lineStart":7,"lineEnd":8,"ayah":18,"text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ﰑ","textImlaei":"من أي شيء خلقه","tafseer":"[18]  ألم ير مِن أيِّ شيء خلقه الله أول مرة؟"},{"id":5777,"juz":30,"page":585,"lineStart":8,"lineEnd":8,"ayah":19,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ﰒ","textImlaei":"من نطفة خلقه فقدره","tafseer":"[19] خلقه الله من ماء قليل -وهو المنيُّ- فقدَّره أطواراً"},{"id":5778,"juz":30,"page":585,"lineStart":8,"lineEnd":8,"ayah":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ﰓ","textImlaei":"ثم السبيل يسره","tafseer":"[20] ثم بيَّن له طريق الخير والشر"},{"id":5779,"juz":30,"page":585,"lineStart":9,"lineEnd":9,"ayah":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ﰔ","textImlaei":"ثم أماته فأقبره","tafseer":"[21] ثم أماته فجعل له مكاناً يُقبر فيه"},{"id":5780,"juz":30,"page":585,"lineStart":9,"lineEnd":9,"ayah":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ﰕ","textImlaei":"ثم إذا شاء أنشره","tafseer":"[22] ثم إذا شاء سبحانه أحياه، وبعثه بعد موته للحساب والجزاء"},{"id":5781,"juz":30,"page":585,"lineStart":9,"lineEnd":9,"ayah":23,"text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ﰖ","textImlaei":"كلا لما يقض ما أمره","tafseer":"[23]  ليس الأمر كما يقول الكافر ويفعل، فلم يؤدِّ ما أمره الله به من الإيمان والعمل بطاعته."},{"id":5782,"juz":30,"page":585,"lineStart":10,"lineEnd":10,"ayah":24,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ﰗ","textImlaei":"فلينظر الإنسان إلى طعامه","tafseer":"[24] فليتدبر الإنسان: كيف خلق الله طعامه الذي هو قِوام حياته؟"},{"id":5783,"juz":30,"page":585,"lineStart":10,"lineEnd":10,"ayah":25,"text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ﰘ","textImlaei":"أنا صببنا الماء صبا","tafseer":"[25] بأنَّا صببنا الماء على الأرض صبّاً"},{"id":5784,"juz":30,"page":585,"lineStart":10,"lineEnd":11,"ayah":26,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ﰙ","textImlaei":"ثم شققنا الأرض شقا","tafseer":"[26] ثم شققناها بما أخرجنا منها من نبات شتى  "},{"id":5785,"juz":30,"page":585,"lineStart":11,"lineEnd":11,"ayah":27,"text":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا ﰚ","textImlaei":"فأنبتنا فيها حبا","tafseer":"[27]   فأنبتنا فيها حبّاً"},{"id":5786,"juz":30,"page":585,"lineStart":11,"lineEnd":11,"ayah":28,"text":"وَعِنَبٗا وَقَضۡبٗا ﰛ","textImlaei":"وعنبا وقضبا","tafseer":"[28] وعنباً وعلفاً للدواب"},{"id":5787,"juz":30,"page":585,"lineStart":11,"lineEnd":11,"ayah":29,"text":"وَزَيۡتُونٗا وَنَخۡلٗا ﰜ","textImlaei":"وزيتونا ونخلا","tafseer":"[29]  وزيتوناً ونخلاً،"},{"id":5788,"juz":30,"page":585,"lineStart":12,"lineEnd":12,"ayah":30,"text":"وَحَدَآئِقَ غُلۡبٗا ﰝ","textImlaei":"وحدائق غلبا","tafseer":"[30] وحدائق عظيمة الأشجار"},{"id":5789,"juz":30,"page":585,"lineStart":12,"lineEnd":12,"ayah":31,"text":"وَفَٰكِهَةٗ وَأَبّٗا ﰞ","textImlaei":"وفاكهة وأبا","tafseer":"[31] وثماراً وكـلأً"},{"id":5790,"juz":30,"page":585,"lineStart":12,"lineEnd":12,"ayah":32,"text":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ﰟ","textImlaei":"متاعا لكم ولأنعامكم","tafseer":"[32]  تَنْعَمون بها أنتم وأنعامكم."},{"id":5791,"juz":30,"page":585,"lineStart":12,"lineEnd":13,"ayah":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ﰠ","textImlaei":"فإذا جاءت الصاخة","tafseer":"[33] فإذا جاءت صيحة البعث يوم القيامة التي تَصَمُّ مِن هولها الأسماع"},{"id":5792,"juz":30,"page":585,"lineStart":13,"lineEnd":13,"ayah":34,"text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ﰡ","textImlaei":"يوم يفر المرء من أخيه","tafseer":"[34] يوم يفرُّ المرء لهول ذلك اليوم من أخيه"},{"id":5793,"juz":30,"page":585,"lineStart":13,"lineEnd":13,"ayah":35,"text":"وَأُمِّهِۦ وَأَبِيهِ ﰢ","textImlaei":"وأمه وأبيه","tafseer":"[35] وأمه وأبيه"},{"id":5794,"juz":30,"page":585,"lineStart":13,"lineEnd":14,"ayah":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ ﰣ","textImlaei":"وصاحبته وبنيه","tafseer":"[36]  وزوجه وبنيه"},{"id":5795,"juz":30,"page":585,"lineStart":14,"lineEnd":14,"ayah":37,"text":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ﰤ","textImlaei":"لكل امرئ منهم يومئذ شأن يغنيه","tafseer":"[37] لكل واحد منهم يومئذٍ أمر يمنعه من الانشغال بغيره."},{"id":5796,"juz":30,"page":585,"lineStart":14,"lineEnd":15,"ayah":38,"text":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ﰥ","textImlaei":"وجوه يومئذ مسفرة","tafseer":"[38] وجوه أهل النعيم في ذلك اليوم مستنيرة"},{"id":5797,"juz":30,"page":585,"lineStart":15,"lineEnd":15,"ayah":39,"text":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ﰦ","textImlaei":"ضاحكة مستبشرة","tafseer":"[39]  مسرورة فرحة"},{"id":5798,"juz":30,"page":585,"lineStart":15,"lineEnd":15,"ayah":40,"text":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ﰧ","textImlaei":"ووجوه يومئذ عليها غبرة","tafseer":"[40] ووجوه أهل الجحيم مظلمة مسودَّة."},{"id":5799,"juz":30,"page":586,"lineStart":1,"lineEnd":1,"ayah":41,"text":"تَرۡهَقُهَا قَتَرَةٌ ﰨ","textImlaei":"ترهقها قترة","tafseer":"[41] تغشاها ذلَّة"},{"id":5800,"juz":30,"page":586,"lineStart":1,"lineEnd":1,"ayah":42,"text":"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ﰩ","textImlaei":"أولئك هم الكفرة الفجرة","tafseer":"[42] أولئك الموصوفون بهذا الوصف هم الذين كفروا بنعم الله وكذَّبوا بآياته، وتجرؤوا على محارمه بالفجور والطغيان."}]}
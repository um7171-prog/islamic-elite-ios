# ------------------------------------------------------------------
# Environment variables template
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the frontend.
# ------------------------------------------------------------------

# Backend (Supabase / Lovable Cloud) project reference id
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Backend API base URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Public (anon / publishable) key — safe to ship in the client bundle
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# ------------------------------------------------------------------
# Translation (api/translate.ts — a Vercel function deployed with the site)
# ------------------------------------------------------------------
# Optional, public: where the app sends translation requests. Default:
# "/api/translate" on the web, https://www.techsnds.com/api/translate in the iPhone app.
# VITE_TRANSLATE_API_URL=""
#
# SERVER-SIDE ONLY — set these in Vercel -> Project -> Settings -> Environment
# Variables, never here with a VITE_ prefix (they must not reach the app bundle):
#   GOOGLE_TRANSLATE_API_KEY  optional: Google Cloud Translation (otherwise the free MyMemory API is used)
#   MYMEMORY_EMAIL            optional: raises MyMemory's free daily quota
#   GEMINI_API_KEY            optional: enables translating text inside an image
